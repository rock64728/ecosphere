<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. The Report Action (Tells Odoo to add the 'Print' button) -->
        <record id="action_report_department_score" model="ir.actions.report">
            <field name="name">ESG Summary Report</field>
            <field name="model">ecosphere.department.score</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ecosphere.report_department_score</field>
            <field name="report_file">ecosphere.report_department_score</field>
            <field name="print_report_name">'ESG_Report_%s' % (object.department_id.name)</field>
            <field name="binding_model_id" ref="model_ecosphere_department_score"/>
            <field name="binding_type">report</field>
        </record>

        <!-- 2. The PDF Template (HTML/QWeb structure) -->
        <template id="report_department_score">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <!-- 'web.external_layout' adds your company header/footer/logo -->
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            <h2 class="text-center" style="color: #2E8B57; margin-bottom: 20px;">
                                EcoSphere ESG Summary Report
                            </h2>
                            <hr/>
                            
                            <div class="row mt32 mb32">
                                <div class="col-6">
                                    <strong>Department:</strong>
                                    <p style="font-size: 18px;" t-field="doc.department_id.name"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Total ESG Score:</strong>
                                    <p style="font-size: 28px; font-weight: bold; color: #2E8B57;" t-field="doc.total_score"/>
                                </div>
                            </div>

                            <table class="table table-sm o_main_table mt-4">
                                <thead>
                                    <tr style="background-color: #f8f9fa;">
                                        <th>ESG Category</th>
                                        <th class="text-end">Score (0-100)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>Environmental</strong> (Based on Carbon Tracking)</td>
                                        <td class="text-end"><span t-field="doc.env_score"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Social</strong> (Based on CSR Participation)</td>
                                        <td class="text-end"><span t-field="doc.soc_score"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Governance</strong> (Base Compliance)</td>
                                        <td class="text-end"><span t-field="doc.gov_score"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <div class="mt-5" style="border-top: 1px solid #ddd; padding-top: 10px;">
                                <p class="text-muted"><em>* Scores are calculated automatically in real-time based on operational data and employee gamification metrics.</em></p>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>